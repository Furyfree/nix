# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Machine data, written by the installer or by hand; use path: flakes to
# include it locally.
nixos/hosts/*/local/
darwin/local/
ubuntu/local/
windows/local/

# Python development environments and caches
.venv/
.ruff_cache/
.pytest_cache/
__pycache__/
*.py[cod]
