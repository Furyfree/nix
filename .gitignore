# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Installer-generated machine data; use path: flakes to include it locally.
hosts/*/local/

# Private shell overrides belong in ~/.config/zsh, never in the public repo.
configs/zsh/local.zsh

# Python development environments and caches
.venv/
.ruff_cache/
.pytest_cache/
__pycache__/
*.py[cod]
