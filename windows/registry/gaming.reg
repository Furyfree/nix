Windows Registry Editor Version 5.00

; desktop, through gaming.psd1.

; Game Mode on; Game DVR and background recording off
[HKEY_CURRENT_USER\Software\Microsoft\GameBar]
"AutoGameModeEnabled"=dword:00000001
"AllowAutoGameMode"=dword:00000001

[HKEY_CURRENT_USER\System\GameConfigStore]
"GameDVR_Enabled"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\GameDVR]
"AppCaptureEnabled"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\GameDVR]
"AllowGameDVR"=dword:00000000

; Hardware-accelerated GPU scheduling, from the next boot
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers]
"HwSchMode"=dword:00000002

; Less CPU held back for background work; games first for CPU and GPU time
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile]
"SystemResponsiveness"=dword:0000000a

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games]
"GPU Priority"=dword:00000008
"Priority"=dword:00000006
"Scheduling Category"="High"

; No power throttling of background processes, from the next boot
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\PowerThrottling]
"PowerThrottlingOff"=dword:00000001

; No mouse acceleration
[HKEY_CURRENT_USER\Control Panel\Mouse]
"MouseSpeed"="0"
"MouseThreshold1"="0"
"MouseThreshold2"="0"

; Launchers start when opened, not at sign-in: off in Settings > Apps >
; Startup, by each Run entry name, as in personal.reg
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run]
"Steam"=hex:01,00,00,00,00,00,00,00,00,00,00,00
"Battle.net"=hex:01,00,00,00,00,00,00,00,00,00,00,00
"EpicGamesLauncher"=hex:01,00,00,00,00,00,00,00,00,00,00,00
"RiotClient"=hex:01,00,00,00,00,00,00,00,00,00,00,00
"Discord"=hex:01,00,00,00,00,00,00,00,00,00,00,00

; Discord's machine-wide installer, which checks each sign-in for a missing
; Discord
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run32]
"Discord"=hex:01,00,00,00,00,00,00,00,00,00,00,00
