[user]
	useConfigOnly = true
	name = Patrick Byrne
	email = pby.accounts@byrne.dk
	# The personal key as text, so signing needs no key file; 1Password signs.
	signingkey = "key::ssh-ed25519 REMOVED-PUBLIC-KEY"

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	# Replay local commits on top of the remote when branches diverge.
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true

[rebase]
	autoSquash = true
	updateRefs = true
	missingCommitsCheck = error

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[column]
	ui = auto

[help]
	autocorrect = prompt

[commit]
	verbose = true
	gpgsign = true

[alias]
	st = status --short --branch
	lg = log --graph --oneline --decorate --all

[gpg]
	format = ssh

[gpg "ssh"]
	# On PATH from the 1Password app module.
	program = op-ssh-sign
