[user]
	useConfigOnly = true
	name = Patrick Byrne
	email = pby.accounts@byrne.dk
	# The personal key as text, so signing needs no key file; 1Password signs.
	signingkey = "key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIERraLz/cuC5BF1Vebrw1bL01otOZ3sXY4iLKsivbK9p"

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	# Replay local commits on top of the remote when branches diverge.
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true

[rebase]
	autoSquash = true
	updateRefs = true
	missingCommitsCheck = error

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[column]
	ui = auto

[help]
	autocorrect = prompt

[commit]
	verbose = true
	gpgsign = true

[alias]
	st = status --short --branch
	lg = log --graph --oneline --decorate --all

[gpg]
	format = ssh

[gpg "ssh"]
	# On PATH from the 1Password app module.
	program = op-ssh-sign
	# Lets git log --show-signature verify commits signed with the personal key.
	allowedSignersFile = ~/.config/git/allowed_signers

# As `git lfs install` writes it, so a project running that changes nothing.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
