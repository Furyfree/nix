# Noctalia's terminal colours for Ptyxis, Ubuntu's own terminal; Noctalia
# writes this to Ptyxis's palettes and Ptyxis picks Light or Dark itself.
[Palette]
Name=Noctalia

[Light]
Background={{colors.terminal_background.light.hex}}
Foreground={{colors.terminal_foreground.light.hex}}
Cursor={{colors.terminal_cursor.light.hex}}
Color0={{colors.terminal_normal_black.light.hex}}
Color1={{colors.terminal_normal_red.light.hex}}
Color2={{colors.terminal_normal_green.light.hex}}
Color3={{colors.terminal_normal_yellow.light.hex}}
Color4={{colors.terminal_normal_blue.light.hex}}
Color5={{colors.terminal_normal_magenta.light.hex}}
Color6={{colors.terminal_normal_cyan.light.hex}}
Color7={{colors.terminal_normal_white.light.hex}}
Color8={{colors.terminal_bright_black.light.hex}}
Color9={{colors.terminal_bright_red.light.hex}}
Color10={{colors.terminal_bright_green.light.hex}}
Color11={{colors.terminal_bright_yellow.light.hex}}
Color12={{colors.terminal_bright_blue.light.hex}}
Color13={{colors.terminal_bright_magenta.light.hex}}
Color14={{colors.terminal_bright_cyan.light.hex}}
Color15={{colors.terminal_bright_white.light.hex}}

[Dark]
Background={{colors.terminal_background.dark.hex}}
Foreground={{colors.terminal_foreground.dark.hex}}
Cursor={{colors.terminal_cursor.dark.hex}}
Color0={{colors.terminal_normal_black.dark.hex}}
Color1={{colors.terminal_normal_red.dark.hex}}
Color2={{colors.terminal_normal_green.dark.hex}}
Color3={{colors.terminal_normal_yellow.dark.hex}}
Color4={{colors.terminal_normal_blue.dark.hex}}
Color5={{colors.terminal_normal_magenta.dark.hex}}
Color6={{colors.terminal_normal_cyan.dark.hex}}
Color7={{colors.terminal_normal_white.dark.hex}}
Color8={{colors.terminal_bright_black.dark.hex}}
Color9={{colors.terminal_bright_red.dark.hex}}
Color10={{colors.terminal_bright_green.dark.hex}}
Color11={{colors.terminal_bright_yellow.dark.hex}}
Color12={{colors.terminal_bright_blue.dark.hex}}
Color13={{colors.terminal_bright_magenta.dark.hex}}
Color14={{colors.terminal_bright_cyan.dark.hex}}
Color15={{colors.terminal_bright_white.dark.hex}}
