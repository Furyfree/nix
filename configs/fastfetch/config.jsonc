{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "nixos",
    "padding": {
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "default"
    },
    "size": {
      "ndigits": 1
    },
    "disableLinewrap": true
  },
  "modules": [
    {
      "type": "custom",
      "format": "lua:-- Fastfetch's shared Lua state: native collectors stay silent; fixed rows below\n-- keep the palette aligned with the hat even when hardware is unavailable.\nff = {gpus = {}, displays = {}}\n\nfunction ff.text(value)\n  if value == nil or value == '' then return 'not detected' end\n  local text = tostring(value):gsub('[%c]', ' ')\n  local chars = {}\n  for char in text:gmatch('[%z\\1-\\127\\194-\\244][\\128-\\191]*') do\n    chars[#chars + 1] = char\n  end\n  if #chars > 46 then\n    return table.concat(chars, '', 1, 45) .. '…'\n  end\n  return text\nend\n\nfunction ff.name(value)\n  if not value then return nil end\n  return ((value.prettyName or value.name or '') .. ' ' .. (value.version or '')):gsub('%s+$', '')\nend\n\nfunction ff.cpuName()\n  if not ff.cpu then return nil end\n  return ff.cpu.name:gsub('%d+th Gen ', ''):gsub('%(R%)', ''):gsub('%(TM%)', '')\nend\n\nfunction ff.gpuNames()\n  local names = {}\n  for _, gpu in ipairs(ff.gpus) do\n    local name = gpu.name:gsub('GeForce ', ''):gsub(' Lite Hash Rate', '')\n    if gpu.vendor == 'Intel' then name = name:gsub('UHD Graphics ', 'Intel UHD ') end\n    names[#names + 1] = name\n  end\n  return table.concat(names, ' + ')\nend\n\nfunction ff.displayNames()\n  local order, counts = {}, {}\n  for _, display in ipairs(ff.displays) do\n    local hz = tonumber(display.refreshRate)\n    local name = string.format('%d×%d', display.width, display.height)\n    if hz then name = name .. string.format(' @ %g Hz', math.floor(hz * 10 + 0.5) / 10) end\n    if not counts[name] then order[#order + 1] = name; counts[name] = 0 end\n    counts[name] = counts[name] + 1\n  end\n  for i, name in ipairs(order) do\n    if counts[name] > 1 then order[i] = counts[name] .. ' × ' .. name end\n  end\n  return table.concat(order, ' + ')\nend\n\nfunction ff.packageCounts()\n  if not ff.packages then return nil end\n  local rows, counted = {}, 0\n  for _, item in ipairs({ {'rpm', 'rpm'}, {'dpkg', 'dpkg'}, {'pacman', 'pacman'},\n                         {'apk', 'apk'}, {'flatpakAll', 'flatpak'}, {'nixAll', 'nix'}}) do\n    local count = ff.packages[item[1]] or 0\n    -- Flatpak's total includes runtimes; show installed apps when counted.\n    local shown = item[1] == 'flatpakAll' and ff.flatpakApps or count\n    if count > 0 then rows[#rows + 1] = shown .. ' ' .. item[2]; counted = counted + count end\n  end\n  local other = (ff.packages.all or 0) - counted\n  if other > 0 then rows[#rows + 1] = other .. ' other' end\n  return #rows > 0 and table.concat(rows, ' · ') or '0'\nend\n\nfunction ff.uptimeText()\n  if not ff.uptime then return nil end\n  local a = ff.uptime\n  return (a.days > 0 and a.days .. 'd ' or '') .. a.hours .. 'h ' .. a.minutes .. 'm'\nend\n\nfunction ff.usage(value)\n  if not value then return nil end\n  return (value.used or value.sizeUsed) .. ' / ' .. (value.total or value.sizeTotal)\nend\n"
    },
    {
      "type": "os",
      "format": "lua:ff.os = ..."
    },
    {
      "type": "kernel",
      "format": "lua:ff.kernel = ..."
    },
    {
      "type": "uptime",
      "format": "lua:ff.uptime = ..."
    },
    {
      "type": "packages",
      "format": "lua:ff.packages = ..."
    },
    {
      "type": "de",
      "format": "lua:ff.de = ..."
    },
    {
      "type": "wm",
      "format": "lua:ff.wm = ..."
    },
    {
      "type": "shell",
      "format": "lua:ff.shell = ..."
    },
    {
      "type": "terminal",
      "format": "lua:ff.terminal = ..."
    },
    {
      "type": "cpu",
      "format": "lua:ff.cpu = ..."
    },
    {
      "type": "memory",
      "format": "lua:ff.memory = ..."
    },
    {
      "type": "gpu",
      "format": "lua:table.insert(ff.gpus, ...)"
    },
    {
      "type": "display",
      "format": "lua:table.insert(ff.displays, ...)"
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "lua:ff.disk = ..."
    },
    {
      "type": "command",
      "text": "# The native package's running process is named noctalia. Installation alone\n# does not establish that this shell is running.\nif pgrep -u \"$(id -u)\" -x noctalia >/dev/null 2>&1; then\n  # `noctalia --version` prints \"noctalia v5.1.0\"; keep the plain label otherwise.\n  version=$(noctalia --version 2>/dev/null)\n  version=${version#noctalia v}\n  case $version in\n    '' | *[!0-9.]*) printf 'Noctalia (desktop shell)' ;;\n    *) printf 'Noctalia %s (desktop shell)' \"$version\" ;;\n  esac\nfi\n",
      "format": "lua:ff.noctalia = (...).result",
      "timeout": 1000
    },
    {
      "type": "command",
      "text": "find /var/lib/flatpak/app \"$HOME/.local/share/flatpak/app\" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l",
      "format": "lua:ff.flatpakApps = tonumber((...).result)",
      "timeout": 1000
    },
    {
      "type": "custom",
      "format": "{#2}── {#}{#1}SYSTEM{#}{#2} ───────────────────────────────────────────────────{#}"
    },
    {
      "type": "custom",
      "key": "OS          ",
      "format": "lua:return ff.text(ff.os and (ff.os.name .. ' ' .. ff.os.versionId))"
    },
    {
      "type": "custom",
      "key": "Kernel      ",
      "format": "lua:return ff.text(ff.kernel and ff.kernel.release)"
    },
    {
      "type": "custom",
      "key": "Uptime      ",
      "format": "lua:return ff.text(ff.uptimeText())"
    },
    {
      "type": "custom",
      "key": "Packages    ",
      "format": "lua:return ff.text(ff.packageCounts())"
    },
    "break",
    {
      "type": "custom",
      "format": "{#2}── {#}{#1}DESKTOP{#}{#2} ──────────────────────────────────────────────────{#}"
    },
    {
      "type": "custom",
      "key": "DE          ",
      "format": "lua:return ff.text(ff.name(ff.de) or ff.noctalia)"
    },
    {
      "type": "custom",
      "key": "WM          ",
      "format": "lua:return ff.text(ff.name(ff.wm))"
    },
    {
      "type": "custom",
      "key": "Shell       ",
      "format": "lua:return ff.text(ff.name(ff.shell))"
    },
    {
      "type": "custom",
      "key": "Terminal    ",
      "format": "lua:return ff.text(ff.name(ff.terminal))"
    },
    "break",
    {
      "type": "custom",
      "format": "{#2}── {#}{#1}HARDWARE{#}{#2} ─────────────────────────────────────────────────{#}"
    },
    {
      "type": "custom",
      "key": "CPU         ",
      "format": "lua:return ff.text(ff.cpuName())"
    },
    {
      "type": "custom",
      "key": "GPU         ",
      "format": "lua:return ff.text(ff.gpuNames())"
    },
    {
      "type": "custom",
      "key": "Display     ",
      "format": "lua:return ff.text(ff.displayNames())"
    },
    {
      "type": "custom",
      "key": "Memory      ",
      "format": "lua:return ff.text(ff.usage(ff.memory))"
    },
    {
      "type": "custom",
      "key": "Disk        ",
      "format": "lua:return ff.text(ff.disk and (ff.usage(ff.disk) .. ' · ' .. ff.disk.filesystem))"
    },
    "break",
    {
      "type": "custom",
      "format": "{#40}  {#} {#41}  {#} {#42}  {#} {#43}  {#} {#44}  {#} {#45}  {#} {#46}  {#} {#47}  {#}"
    }
  ]
}
