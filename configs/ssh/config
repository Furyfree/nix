# Shared by every machine. Hosts and the default key for everything else stay
# in a private 1Password document per profile, fetched as ~/.ssh/local.conf
# (INSTALLATION.md). The .pub files select which agent key to use and also
# come from 1Password.
Include ~/.ssh/local.conf

Host github.com
    User git
    IdentityFile ~/.ssh/github.pub
    IdentitiesOnly yes

Host *
    IdentityAgent ~/.1password/agent.sock
