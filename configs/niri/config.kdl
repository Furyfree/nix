// Load the Niri configuration files from conf.d.

// UWSM prepares the session environment before starting Niri.
include "conf.d/input.kdl"
include "conf.d/monitors.kdl"
include "conf.d/layout.kdl"
include "conf.d/decoration.kdl"
include "conf.d/window-rules.kdl"
include "conf.d/autostart.kdl"
include "conf.d/keybinds.kdl"

// Noctalia owns the generated palette. First login works before it exists,
// and with the include already here, Noctalia does not add one to this file.
include optional=true "noctalia.kdl"

// Per-machine monitors and keys, linked by home/niri.nix. Last, because an
// include overrides only what comes before it.
include optional=true "host.kdl"
