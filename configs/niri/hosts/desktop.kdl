// Desktop monitors and keyboard; home/niri.nix links this file to
// ~/.config/niri/host.kdl on the host named desktop.

// BenQ XL2720Z is the main display; ZOWIE XL LCD is to its right. Matched by
// make, model and serial as niri msg outputs shows them, so swapping cables
// keeps the layout. The firmware, Limine and the unlock prompt use the RTX
// 3080's first DisplayPort, so the BenQ goes there. Without a refresh rate,
// Niri picks the highest.
output "PNP(BNQ) BenQ XL2720Z SCE00737SL0" {
    mode "1920x1080"
    scale 1
    position x=0 y=0
    focus-at-startup
}
output "PNP(BNQ) ZOWIE XL LCD 95H03263SL0" {
    mode "1920x1080"
    scale 1
    position x=1920 y=0
}

// Five workspaces on each monitor always exist. Names are unique across
// monitors, so the ZOWIE's are 6 to 10.
workspace "1" { open-on-output "PNP(BNQ) BenQ XL2720Z SCE00737SL0"; }
workspace "2" { open-on-output "PNP(BNQ) BenQ XL2720Z SCE00737SL0"; }
workspace "3" { open-on-output "PNP(BNQ) BenQ XL2720Z SCE00737SL0"; }
workspace "4" { open-on-output "PNP(BNQ) BenQ XL2720Z SCE00737SL0"; }
workspace "5" { open-on-output "PNP(BNQ) BenQ XL2720Z SCE00737SL0"; }
workspace "6" { open-on-output "PNP(BNQ) ZOWIE XL LCD 95H03263SL0"; }
workspace "7" { open-on-output "PNP(BNQ) ZOWIE XL LCD 95H03263SL0"; }
workspace "8" { open-on-output "PNP(BNQ) ZOWIE XL LCD 95H03263SL0"; }
workspace "9" { open-on-output "PNP(BNQ) ZOWIE XL LCD 95H03263SL0"; }
workspace "10" { open-on-output "PNP(BNQ) ZOWIE XL LCD 95H03263SL0"; }

// The NuPhy has US keycaps; AltGr+a/o/' types å/ø/æ as Option does on macOS.
input {
    keyboard {
        xkb {
            layout "us"
            variant "mac"
        }
    }
}

// US has no unshifted Plus key; Equal widens, and Shift+Equal makes taller.
binds {
    Mod+Equal hotkey-overlay-title="Widen window" { set-column-width "+50"; }
    Mod+Shift+Equal hotkey-overlay-title="Taller window" { set-window-height "+50"; }
}
