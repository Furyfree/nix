// The Ubuntu work laptop; home-manager/niri.nix links this file to
// ~/.config/niri/host.kdl there. No systemd unit starts Noctalia on Ubuntu,
// and apt's apps have their own command names.
spawn-at-startup "noctalia"

binds {
    Mod+Shift+F hotkey-overlay-title="Open file manager" { spawn "nautilus"; }
    Mod+Shift+O hotkey-overlay-title="Focus or open Obsidian" { spawn "launch" "focus" "md.obsidian.Obsidian" "flatpak" "run" "md.obsidian.Obsidian"; }
    Mod+Shift+Z hotkey-overlay-title="Open Zed" { spawn "zed"; }
    Mod+Shift+T hotkey-overlay-title="Focus or open T3 Code" { spawn "launch" "focus" "com.t3tools.T3Code" "t3code"; }
}
