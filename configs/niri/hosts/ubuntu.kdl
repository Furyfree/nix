// The Ubuntu work laptop; home-manager/niri.nix links this file to
// ~/.config/niri/host.kdl there. No systemd unit starts Noctalia on Ubuntu.
// Its apps' keys are here, as NixOS's are in conf.d/nixos.kdl, since apt's
// apps have their own command names.
spawn-at-startup "noctalia"
// Puts big-1 to big-5 first on the laptop panel when the Dell is unplugged.
spawn-at-startup "big-screen-first"

// The laptop panel sits left of the Dell P3222QE, bottom edges lined up: at
// scale 1.25 the Dell is 3072x1728 logical and the panel 1536x960, so the
// panel starts 1728 - 960 = 768 down. The Dell is matched by make, model and
// serial as niri msg outputs shows them, so another port or dock keeps it.
output "eDP-1" {
    mode "1920x1200"
    scale 1.25
    position x=0 y=768
}
output "Dell Inc. DELL P3222QE 5007DH3" {
    mode "3840x2160"
    scale 1.25
    position x=1536 y=0
}

// Five workspaces always exist on each screen; see desktop.kdl for the names.
// Without the Dell, Niri puts its five on the laptop panel.
workspace "main-1" { open-on-output "eDP-1"; }
workspace "main-2" { open-on-output "eDP-1"; }
workspace "main-3" { open-on-output "eDP-1"; }
workspace "main-4" { open-on-output "eDP-1"; }
workspace "main-5" { open-on-output "eDP-1"; }
workspace "big-1" { open-on-output "Dell Inc. DELL P3222QE 5007DH3"; }
workspace "big-2" { open-on-output "Dell Inc. DELL P3222QE 5007DH3"; }
workspace "big-3" { open-on-output "Dell Inc. DELL P3222QE 5007DH3"; }
workspace "big-4" { open-on-output "Dell Inc. DELL P3222QE 5007DH3"; }
workspace "big-5" { open-on-output "Dell Inc. DELL P3222QE 5007DH3"; }

binds {
    // A new window each time, as Strata opens on NixOS; Nautilus alone would
    // focus the open one.
    Mod+Shift+F hotkey-overlay-title="Open file manager" { spawn "nautilus" "--new-window"; }
    Mod+Shift+O hotkey-overlay-title="Focus or open Obsidian" { spawn "launch" "focus" "md.obsidian.Obsidian" "flatpak" "run" "md.obsidian.Obsidian"; }
    Mod+Shift+Z hotkey-overlay-title="Open Zed" { spawn "zed"; }
    Mod+Shift+T hotkey-overlay-title="Focus or open T3 Code" { spawn "launch" "focus" "com.t3tools.T3Code" "t3code"; }
    // The web apps from ubuntu/home.nix, through their launcher entries; Outlook
    // takes Fastmail's key, which this laptop has no app for.
    Mod+Shift+E hotkey-overlay-title="Focus or open Outlook" { spawn-sh "gio launch $HOME/.nix-profile/share/applications/outlook.desktop"; }
    Mod+Shift+X hotkey-overlay-title="Focus or open Teams" { spawn-sh "gio launch $HOME/.nix-profile/share/applications/teams.desktop"; }
}
