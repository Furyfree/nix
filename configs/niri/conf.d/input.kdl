// Keyboard, mouse, touchpad, and cursor settings.

input {
    // Danish layout, Num Lock, and responsive key repeat.
    keyboard {
        xkb {
            layout "dk"
        }
        numlock
        repeat-rate 40
        repeat-delay 250
    }

    // Scroll content directly and use finger count for physical clicks.
    touchpad {
        tap
        natural-scroll
        click-method "clickfinger"
        dwt
    }

    // Focus follows the pointer, and the pointer follows keyboard focus. The
    // pointer skips a window that would scroll the view more than a tenth of
    // the screen, so windows you can see stay put; click to bring it in.
    focus-follows-mouse max-scroll-amount="10%"
    warp-mouse-to-focus
}

// The overview opens from Super+O and a four-finger swipe, not the top-left
// screen corner.
gestures {
    hot-corners {
        off
    }
}

// Niri passes its cursor to the apps it starts; it matches XCURSOR_* in
// nixos/desktop.nix, which the rest of the session gets.
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}
