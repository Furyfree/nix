// Niri gives each its own systemd scope; Noctalia starts through its systemd unit.

spawn-at-startup "udiskie" "--no-tray" "--no-notify"
// Hidden in the tray, so its SSH agent can ask to unlock for Git signing.
// On NixOS, 1Password's own Start at login does not start it; on Ubuntu,
// ubuntu/home.nix keeps that from starting a second copy.
spawn-at-startup "1password" "--silent"
spawn-at-startup "follow-mini-player"
