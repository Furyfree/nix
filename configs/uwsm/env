# Shared environment for UWSM sessions and their user services.
# Retain inherited paths; greetd may not have loaded a shell profile.
PATH=${PATH:-/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin}

# GUI apps need user commands and Mise tools without interactive activation.
uwsm_mise_data=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}
for uwsm_directory in "$uwsm_mise_data/shims" "$HOME/.local/bin"; do
    case ":$PATH:" in
        *":$uwsm_directory:"*) ;;
        *) PATH="$uwsm_directory:$PATH" ;;
    esac
done
# Rider detects SDKs from the real dotnet on PATH; the shim resolves to mise.
case ":$PATH:" in
    *":$uwsm_mise_data/dotnet-root:"*) ;;
    *) PATH="$uwsm_mise_data/dotnet-root:$PATH" ;;
esac
export PATH
# Apphosts use DOTNET_ROOT; GUI apps don't run mise activation.
export DOTNET_ROOT="$uwsm_mise_data/dotnet-root"
unset uwsm_mise_data uwsm_directory

# Respect an inherited editor choice.
export EDITOR="${EDITOR:-nvim}"
export EDITOR
export VISUAL="${VISUAL:-$EDITOR}"

# Zed's .ipynb grid is a staff preview; GUI apps do not read shell profiles.
export LOCAL_NOTEBOOK_DEV=1
