# Retain inherited paths; greetd does not load a shell profile.
PATH=${PATH:-/run/wrappers/bin:/run/current-system/sw/bin}

uwsm_mise_data=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}
for uwsm_directory in \
    /run/current-system/sw/bin \
    /run/wrappers/bin \
    "/etc/profiles/per-user/$USER/bin" \
    "$HOME/.nix-profile/bin" \
    "$uwsm_mise_data/shims" \
    "$HOME/.local/bin"; do
    case ":$PATH:" in
        *":$uwsm_directory:"*) ;;
        *) PATH="$uwsm_directory:$PATH" ;;
    esac
done
export PATH
unset uwsm_mise_data uwsm_directory

# Agents write bash, so run their commands in bash; .zshenv sets the same.
export CLAUDE_CODE_SHELL=/run/current-system/sw/bin/bash
export GROK_SHELL=/run/current-system/sw/bin/bash
# T3 Code writes its t3code:// link handler with this command; the Nix package
# leaves it unset, so the handler would start bare Electron.
export T3CODE_DESKTOP_LAUNCHER_PATH=/run/current-system/sw/bin/t3code-desktop

# Prefer native Wayland, with X11 as a fallback. GTK does so by itself;
# env-hyprland forces it there only.
export QT_QPA_PLATFORM='wayland;xcb'
export ELECTRON_OZONE_PLATFORM_HINT=auto
# nixpkgs wrappers (Spotify, Obsidian, Vesktop, VSCodium) run natively on
# Wayland only with this; otherwise they scale blurrily through XWayland.
export NIXOS_OZONE_WL=1
export GTK_IM_MODULE=simple

# qt6ct also accepts qt5ct, allowing both Qt generations to load their plugin.
export QT_QPA_PLATFORMTHEME=qt5ct

export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24
