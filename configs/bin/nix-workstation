#!/usr/bin/env bash
# Rebuild, update and maintain this workstation: NixOS on Linux, nix-darwin on
# macOS. aliases.zsh adds nswitch, nupdate, ninfo, nrollback, nclean, nsearch,
# ndesktop, mup and fup.
set -euo pipefail

# path: includes the ignored machine data in hosts/<host>/local/.
export NH_FLAKE=${NH_FLAKE:-path:$HOME/Projects/nix}
repo=${NH_FLAKE#path:}

darwin=false
[[ $OSTYPE == darwin* ]] && darwin=true

help() {
  case ${1-} in
    switch)
      cat <<'EOF'
usage: nix-workstation switch   (alias: nswitch)

Build the system and show the package changes, then ask before switching.
A yes takes a Snapper pre snapshot, switches and takes the post snapshot.
A failed build or a no changes nothing and leaves no snapshots.

On macOS: build the Mac's nix-darwin configuration, show the changes, ask,
then switch (nh darwin switch --ask). The switch installs missing Homebrew
apps and writes the macOS settings.
EOF
      ;;
    update)
      cat <<'EOF'
usage: nix-workstation update [INPUT...]   (alias: nupdate)

Update all flake inputs, or only the named ones (nixpkgs, home-manager,
nix-darwin), and show the flake.lock diff. Then run just check and switch.
If a step fails or you answer no, flake.lock stays updated and the undo
command is printed. On macOS, nix flake check replaces just check, which
needs Linux tools.
EOF
      ;;
    info)
      cat <<'EOF'
usage: nix-workstation info   (alias: ninfo)

List system generations with build dates, versions and sizes (nh os info).
On macOS, list nix-darwin generations (darwin-rebuild --list-generations);
nrollback takes their numbers.
EOF
      ;;
    rollback)
      cat <<'EOF'
usage: nix-workstation rollback GENERATION   (alias: nrollback)

macOS: switch to an earlier nix-darwin generation from nix-workstation info
(darwin-rebuild --switch-generation). Homebrew apps and written macOS
settings stay as they are.
On Linux, roll back from the boot menu or a Snapper snapshot instead.
EOF
      ;;
    clean)
      cat <<'EOF'
usage: nix-workstation clean   (alias: nclean)

Remove old generations and unused store paths. Keeps the newest 10, the boot
menu's entries, and project build roots; lists what goes and asks first
(nh clean all --no-gcroots --keep 10 --ask).
EOF
      ;;
    search)
      cat <<'EOF'
usage: nix-workstation search [packages|options|prs|issues] QUERY...   (alias: nsearch)

Search nixpkgs packages, NixOS and Home Manager options, or nixpkgs pull
requests and issues (nh search). nh search --help lists its options.
EOF
      ;;
    desktop)
      cat <<'EOF'
usage: nix-workstation desktop [NAME]   (alias: ndesktop)

Without NAME, show the compositor this machine has chosen and the one
running now. With NAME, such as niri or hyprland, save it as the machine's
choice in hosts/<host>/local/desktop.nix, build and show the package
changes, then ask before adding it to the boot menu. A yes takes Snapper
snapshots around it, as switch does, then offers to reboot; the running
session stays as it is until then. A failed build or a no puts the old
choice back. Linux only.
EOF
      ;;
    mise)
      cat <<'EOF'
usage: nix-workstation mise   (alias: mup)

Upgrade the tools Mise manages (mise upgrade).
EOF
      ;;
    firmware)
      cat <<'EOF'
usage: nix-workstation firmware   (alias: fup)

Refresh the firmware list and install updates; fwupdmgr asks before
flashing (fwupdmgr refresh --force, then fwupdmgr update). Linux only; macOS
updates come from Software Update.
EOF
      ;;
    *)
      cat <<'EOF'
usage: nix-workstation COMMAND [ARGS...]

Commands (alias):
  switch (nswitch)             build, show changes, ask, then switch
  update (nupdate) [INPUT...]  update flake inputs, run just check, then switch
  info (ninfo)                 list system generations
  rollback (nrollback) GEN     macOS: switch to an earlier generation
  clean (nclean)               remove old generations; keeps the newest 10
  search (nsearch) QUERY...    search packages and options
  desktop (ndesktop) [NAME]    show or pick the compositor for the next boot
  mise (mup)                   upgrade Mise tools
  firmware (fup)               install firmware updates

Run nix-workstation COMMAND --help for details.
EOF
      ;;
  esac
}

usage() {
  help "$@" >&2
  exit 2
}

die() {
  printf 'nix-workstation: %s\n' "$*" >&2
  exit 1
}

# A failed or declined build leaves no snapshots behind. With "boot", the build
# only becomes the boot default; LABEL starts the snapshot description.
booted=false
cmd_switch() {
  local mode=${1-switch} label=${2-nswitch} answer description pre result=0
  nh os build
  if [[ $mode == boot ]]; then
    read -rp 'Boot into it next time? [y/N] ' answer
  else
    read -rp 'Switch? [y/N] ' answer
  fi
  [[ $answer == [yY]* ]] || die 'not switched'

  description="$label $(git -C "$repo" describe --always --dirty 2>/dev/null || true)"
  pre=$(sudo snapper -c root create --type pre --cleanup-algorithm number --print-number --description "$description")
  # The build above is reused; its diff was already shown. Boot default first,
  # then activate, as nixos-rebuild does: nh os switch skips the boot default
  # when any service fails during activation.
  if nh os boot --diff never; then
    booted=true
    if [[ $mode != boot ]]; then
      nh os test --diff never || result=$?
    fi
  else
    result=$?
  fi
  if ! sudo snapper -c root create --type post --pre-number "$pre" --cleanup-algorithm number --description "$description"; then
    printf 'nix-workstation: post snapshot failed; pre snapshot is #%s\n' "$pre" >&2
    ((result)) || result=1
  fi
  return "$result"
}

# The choice lives in the ignored hosts/<host>/local/desktop.nix; without it,
# components/desktop.nix's default applies. Only the next boot changes:
# activating now would remove the running compositor from under the session.
cmd_desktop() {
  local host state current answer
  host=$(uname -n)
  desktop_file=$repo/hosts/$host/local/desktop.nix
  [[ -d ${desktop_file%/*} ]] || die "hosts/$host/local is missing"
  state=$(nix eval --json "$NH_FLAKE#nixosConfigurations.$host" --apply '
    host: {
      current = host.config.workstation.desktop;
      names = host.options.workstation.desktop.type.functor.payload.values;
    }')
  current=$(jq -r .current <<<"$state")
  if (($# == 0)); then
    printf 'Chosen: %s\nRunning: %s\n' "$current" "${XDG_CURRENT_DESKTOP:-none}"
    return
  fi
  jq -e --arg name "$1" '.names | index($name)' <<<"$state" >/dev/null ||
    die "$1 is not a compositor; choose one of: $(jq -r '.names | join(", ")' <<<"$state")"
  if [[ $1 == "$current" ]]; then
    printf '%s is already chosen.\n' "$1"
    return
  fi

  desktop_old=
  [[ -e $desktop_file ]] && desktop_old=$(<"$desktop_file")
  trap restore_desktop EXIT
  printf '{ workstation.desktop = "%s"; }\n' "$1" >"$desktop_file"
  cmd_switch boot "ndesktop $1"
  trap - EXIT
  read -rp 'Reboot now? [y/N] ' answer
  if [[ $answer == [yY]* ]]; then
    systemctl reboot
  fi
}

# Put the old choice back unless the new one reached the boot menu.
restore_desktop() {
  $booted && return
  if [[ -n $desktop_old ]]; then
    printf '%s\n' "$desktop_old" >"$desktop_file"
  else
    rm -f -- "$desktop_file"
  fi
  printf 'nix-workstation: kept the previous compositor\n' >&2
}

# nh shows the changes and asks; it runs the activation through sudo.
cmd_switch_darwin() {
  [[ -e $repo/hosts/macos/local/user.nix ]] ||
    die 'hosts/macos/local/user.nix is missing; it names the account and profile'
  nh darwin switch --ask --hostname macos
}

# An updated but unapplied lock stays for debugging.
cmd_update() {
  nix flake update "$@" --flake "$NH_FLAKE"
  if git -C "$repo" diff --quiet -- flake.lock; then
    printf 'flake.lock is unchanged.\n'
  else
    git -C "$repo" --no-pager diff -- flake.lock
    trap '(($? == 0)) || printf "Undo: git -C %q restore flake.lock\n" "$repo" >&2' EXIT
  fi
  if $darwin; then
    # just check needs Hyprland, Niri and the Linux dev shell; macOS only
    # evaluates.
    nix flake check --no-build "$NH_FLAKE"
    cmd_switch_darwin
  else
    (cd -- "$repo" && nix develop path:. -c just check)
    cmd_switch
  fi
}

command=${1-}
(($#)) && shift
for arg in "$command" "$@"; do
  if [[ $arg == -h || $arg == --help ]]; then
    help "$command"
    exit
  fi
done

[[ $NH_FLAKE == path:* ]] || die 'NH_FLAKE must be a path: flake'
case $command in
  clean) nh clean all --no-gcroots --keep 10 --ask "$@" ;;
  search) nh search "$@" ;;
  update) cmd_update "$@" ;;
  mise) (($# == 0)) || usage mise; mise upgrade ;;
  *)
    if $darwin; then
      case $command in
        switch) (($# == 0)) || usage switch; cmd_switch_darwin ;;
        info) (($# == 0)) || usage info; darwin-rebuild --list-generations ;;
        rollback)
          (($# == 1)) && [[ $1 =~ ^[0-9]+$ ]] || usage rollback
          sudo darwin-rebuild --switch-generation "$1"
          ;;
        firmware) die 'macOS updates come from Software Update' ;;
        desktop) die 'the compositor choice is Linux only' ;;
        *) usage ;;
      esac
    else
      case $command in
        switch) (($# == 0)) || usage switch; cmd_switch ;;
        info) nh os info "$@" ;;
        desktop) (($# <= 1)) || usage desktop; cmd_desktop "$@" ;;
        rollback) die 'on Linux, roll back from the boot menu or a Snapper snapshot' ;;
        # --force: a plain refresh fails when the metadata is recent.
        firmware) (($# == 0)) || usage firmware; fwupdmgr refresh --force && fwupdmgr update ;;
        *) usage ;;
      esac
    fi
    ;;
esac
