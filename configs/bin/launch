#!/bin/sh
# Small desktop helpers for launcher entries and keybinds under Hyprland and
# Niri, after Omarchy's omarchy-launch-* scripts.
usage() {
  cat >&2 <<'EOF'
usage: launch webapp URL          open a site as an app window
       launch focus-webapp URL    focus its window, or open it
       launch focus CLASS COMMAND...  focus the app's window, or run COMMAND
       launch floating-terminal [COMMAND...]
       launch tui COMMAND [ARGS...]   run in its own terminal window, or focus it
       launch nautilus-cwd        open Files in the focused terminal's folder
EOF
  exit 2
}

# Focus the most recently used window whose class (app ID under Niri) passes
# the jq test $2, which compares it with $match ($1); fail if there is none.
focus() {
  if [ -n "${NIRI_SOCKET-}" ]; then
    id=$(niri msg --json windows |
      jq -r --arg match "$1" "[.[] | select(.app_id // \"\" | $2)] | max_by(.focus_timestamp | [.secs, .nanos]) | .id // empty")
    [ -n "$id" ] && niri msg action focus-window --id "$id" >/dev/null
  else
    address=$(hyprctl clients -j |
      jq -r --arg match "$1" "[.[] | select((.hidden | not) and (.class | $2))] | min_by(.focusHistoryID | if . < 0 then infinite else . end) | .address // empty")
    [ -n "$address" ] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
  fi
}

site() {
  case $1 in
    http://* | https://*) ;;
    *)
      printf '%s\n' 'launch: web apps need an http(s) URL' >&2
      exit 2
      ;;
  esac
  host=${1#*://}
  host=${host%%/*}
  # Brave leaves the port out of app window names.
  host=${host%:*}
}

case ${1-} in
  webapp)
    [ "$#" -eq 2 ] || usage
    site "$2"
    exec uwsm-app -- brave-origin --app="$2"
    ;;
  focus-webapp)
    [ "$#" -eq 2 ] || usage
    site "$2"
    # Brave names app windows after the site, such as ...www.fotmob.com__-Default.
    focus "$host" 'contains($match)' || exec uwsm-app -- brave-origin --app="$2"
    ;;
  focus)
    [ "$#" -ge 3 ] || usage
    class=$2
    shift 2
    # The exact class in any case: launcher names and desktop metadata can
    # differ, and Vesktop's class changes case.
    focus "$class" 'ascii_downcase == ($match | ascii_downcase)' || exec "$@"
    ;;
  floating-terminal)
    shift
    # Window rules float and centre this Ghostty class.
    if [ "$#" -eq 0 ]; then
      exec uwsm-app -- ghostty --class=com.mitchellh.ghostty.presentation
    fi
    exec uwsm-app -- ghostty --class=com.mitchellh.ghostty.presentation -e "$@"
    ;;
  tui)
    [ "$#" -ge 2 ] || usage
    shift
    class="launch.tui.$(basename "$1")"
    focus "$class" 'contains($match)' || exec uwsm-app -- ghostty --class="$class" -e "$@"
    ;;
  nautilus-cwd)
    [ "$#" -eq 1 ] || usage
    # The newest shell under the focused terminal holds its current folder.
    if [ -n "${NIRI_SOCKET-}" ]; then
      terminal=$(niri msg --json focused-window | jq -r '.pid // empty')
    else
      terminal=$(hyprctl activewindow -j | jq -r '.pid // empty')
    fi
    shell=$(cat /proc/"$terminal"/task/*/children 2>/dev/null | tr ' ' '\n' | sort -n | tail -n 1)
    folder=$(readlink /proc/"$shell"/cwd 2>/dev/null) || folder=$HOME
    exec uwsm-app -- nautilus --new-window "${folder:-$HOME}"
    ;;
  *) usage ;;
esac
