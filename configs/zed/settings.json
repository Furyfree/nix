{
  "$schema": "zed://schemas/settings",
  "base_keymap": "VSCode",
  "cli_default_open_behavior": "new_window",
  "default_open_behavior": "new_window",
  "restore_on_startup": "empty_tab",
  "preview_tabs": {
    "enabled": false
  },
  "ui_font_family": "Inter",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "buffer_font_features": {
    "calt": false
  },
  "cursor_shape": "block",
  "colorize_brackets": true,
  "icon_theme": "Material Icon Theme",
  "theme": {
    "mode": "system",
    "light": "Noctalia Light",
    "dark": "Noctalia Dark"
  },
  "format_on_save": "off",
  "autosave": "off",
  "prettier": {
    "allowed": false
  },
  "show_whitespaces": "selection",
  "inlay_hints": {
    "enabled": false
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 15,
    "font_features": {
      "calt": false
    },
    "shell": "system",
    "working_directory": "current_project_directory"
  },
  "file_types": {
    "Shell Script": [
      "dot_zshenv",
      "dot_zprofile",
      "dot_zshrc",
      "dot_zlogin",
      "dot_zlogout"
    ],
    "Go Bash Template": [
      "dot_zsh*.tmpl",
      "dot_zprofile.tmpl"
    ],
    "Go Text Template": [
      "tmpl"
    ]
  },
  "lsp": {
    "tinymist": {
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "$dir/$name"
      }
    }
  },
  "languages": {
    "C": {
      "language_servers": [
        "!sourcekit-lsp",
        "..."
      ]
    },
    "C++": {
      "language_servers": [
        "!sourcekit-lsp",
        "..."
      ]
    },
    "Python": {
      "language_servers": [
        "ty",
        "!basedpyright",
        "..."
      ]
    }
  },
  "auto_install_extensions": {
    "ansible": true,
    "catppuccin": true,
    "csharp": true,
    "csv": true,
    "dart": true,
    "docker-compose": false,
    "dockerfile": true,
    "dracula": true,
    "elixir": true,
    "everforest": true,
    "flexoki-themes": true,
    "fsharp": true,
    "git-firefly": true,
    "github-dark-default": true,
    "github-theme": true,
    "gotmpl": true,
    "graphql": true,
    "gruvbox-material-mix": true,
    "html": true,
    "ini": true,
    "java": true,
    "just": true,
    "kanagawa-themes": true,
    "kotlin": true,
    "latex": true,
    "log": true,
    "lua": true,
    "macos-classic": true,
    "material-icon-theme": true,
    "nginx": true,
    "nix": true,
    "one-dark-pro": true,
    "opencode": true,
    "rainbow-csv": true,
    "rose-pine": true,
    "scala": true,
    "scheme": true,
    "sql": true,
    "svelte": true,
    "swift": true,
    "terraform": true,
    "tokyo-night": true,
    "toml": true,
    "typst": true,
    "xml": true,
    "zig": true
  },
  "auto_update_extensions": {
    "ansible": true,
    "csharp": true,
    "csv": true,
    "dart": true,
    "docker-compose": false,
    "dockerfile": true,
    "elixir": true,
    "fsharp": true,
    "git-firefly": true,
    "gotmpl": true,
    "graphql": true,
    "html": true,
    "ini": true,
    "java": true,
    "kotlin": true,
    "latex": true,
    "log": true,
    "lua": true,
    "nginx": true,
    "nix": true,
    "opencode": true,
    "rainbow-csv": true,
    "scala": true,
    "scheme": true,
    "sql": true,
    "svelte": true,
    "swift": true,
    "terraform": true,
    "toml": true,
    "xml": true,
    "zig": true
  },
  "session": {
    "restore_unsaved_buffers": true,
    "trust_all_worktrees": false
  },
  "project_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "jupyter": {
    "enabled": true
  },
  "feature_flags": {
    "tabular-data-preview": "on",
    "notebooks": "on"
  },
  "agent": {
    "default_profile": "ask",
    "enable_feedback": false,
    "dock": "left",
    "sidebar_side": "left"
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "grok-build": {
      "type": "custom",
      "command": "mise",
      "args": [
        "exec",
        "npm:@xai-official/grok",
        "--",
        "grok",
        "agent",
        "stdio"
      ]
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry",
      "env": {
        "CODEX_PATH": "codex"
      }
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "redact_private_values": true
}
