{
  "$schema": "zed://schemas/settings",
  "base_keymap": "VSCode",
  "show_edit_predictions": false,
  "cli_default_open_behavior": "new_window",
  "default_open_behavior": "new_window",
  "restore_on_startup": "empty_tab",
  "preview_tabs": {
    "enabled": false
  },
  "ui_font_family": "Inter",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "buffer_font_features": {
    "calt": false
  },
  "cursor_shape": "block",
  "colorize_brackets": true,
  "icon_theme": "Material Icon Theme",
  "theme": {
    "mode": "system",
    "light": "Noctalia Light",
    "dark": "Noctalia Dark"
  },
  "format_on_save": "off",
  "autosave": "off",
  "prettier": {
    "allowed": false
  },
  "show_whitespaces": "selection",
  "inlay_hints": {
    "enabled": false
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 15,
    "font_features": {
      "calt": false
    },
    "shell": "system",
    "working_directory": "current_project_directory"
  },
  "lsp": {
    "tinymist": {
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "$dir/$name"
      }
    }
  },
  "languages": {
    "Python": {
      "language_servers": [
        "ty",
        "!basedpyright",
        "..."
      ]
    }
  },
  "auto_install_extensions": {
    "ansible": true,
    "csharp": true,
    "csv": true,
    "dockerfile": true,
    "fsharp": true,
    "git-firefly": true,
    "html": true,
    "ini": true,
    "java": true,
    "just": true,
    "latex": true,
    "log": true,
    "lua": true,
    "material-icon-theme": true,
    "nix": true,
    "scala": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "typst": true,
    "xml": true
  },
  "session": {
    "restore_unsaved_buffers": true,
    "trust_all_worktrees": false
  },
  "project_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "jupyter": {
    "enabled": true
  },
  "feature_flags": {
    "tabular-data-preview": "on",
    "notebooks": "on"
  },
  "agent": {
    "threads_sidebar": {
      "position": "left"
    },
    "default_profile": "ask",
    "enable_feedback": false,
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "redact_private_values": true
}
