#!/usr/bin/env bash
# Rebuild, update and maintain this workstation: NixOS on Linux, nix-darwin on
# macOS, and Home Manager on its own on Linux without NixOS (Ubuntu). aliases.zsh adds nswitch, nupdate, npin, ninfo, nrollback, nclean,
# nsearch, ndesktop, mup and fup.
set -euo pipefail

# path: includes the ignored machine data in each system's local/.
export NH_FLAKE=${NH_FLAKE:-path:$HOME/Projects/nix}
repo=${NH_FLAKE#path:}

darwin=false
[[ $OSTYPE == darwin* ]] && darwin=true
# Linux without NixOS: Home Manager alone, and the distribution's own apps.
home=false
[[ $OSTYPE == linux* && ! -e /etc/NIXOS ]] && home=true
# NixOS in WSL: no Snapper, firmware or compositor. WSL sets this variable.
wsl=false
[[ -n ${WSL_DISTRO_NAME-} ]] && wsl=true

help() {
  case ${1-} in
    switch)
      cat <<'EOF'
usage: nix-workstation switch   (alias: nswitch)

Build the system and show the package changes, then ask before switching.
A yes takes a Snapper pre snapshot, switches and takes the post snapshot.
A failed build or a no changes nothing and leaves no snapshots.

Before the build, a firmware boot list with Windows Boot Manager creates
nixos/hosts/<host>/local/limine-windows, which adds Windows to Limine's menu. It is
never removed by itself; delete it to drop the entry.

On macOS: build the Mac's nix-darwin configuration, show the changes, ask,
then switch (nh darwin switch --ask). The switch installs missing Homebrew
apps and writes the macOS settings.

In WSL: the same without Snapper (nh os switch --ask).

On Linux without NixOS: switch Home Manager (nh home switch --ask), then
ubuntu/apps.sh installs the apps that are missing.

After a switch, Neovim's plugins move to the versions in
configs/nvim/nvim-pack-lock.json, which nupdate writes on one machine.
EOF
      ;;
    update)
      cat <<'EOF'
usage: nix-workstation update [INPUT...]   (alias: nupdate)

Update every flake input and bump the pinned apps as pin does, or update
only the named flake inputs. Then run just check and build the system
without switching, and list what was updated; nswitch applies it. Without
named inputs it also updates Neovim's plugins, which apply at once, and
their configs/nvim/nvim-pack-lock.json; commit it with flake.lock. It never
asks or uses sudo, so an agent can run it. Nothing new skips the build. A
failed step leaves the updated files in place and prints the undo command.

On macOS and in WSL, the pinned apps are skipped. On macOS, nix flake check
replaces just check, which needs Linux tools. Without NixOS, flake.lock comes from NixOS
through Git: run git pull, then nswitch.
EOF
      ;;
    pin)
      cat <<'EOF'
usage: nix-workstation pin [APP...]   (alias: npin)

Bump the apps in nixos/pins/nvfetcher.toml, or only the named ones, to their
newest release with nvfetcher. Claude Desktop's download must match
Anthropic's signed index. Then check and build as update does. To hold an
app at its current version, add pinned = true to its table. The NixOS desktop
and laptop only: macOS, Ubuntu and WSL do not install these apps.
EOF
      ;;
    info)
      cat <<'EOF'
usage: nix-workstation info   (alias: ninfo)

List system generations with build dates, versions and sizes (nh os info).
On macOS, list nix-darwin generations (darwin-rebuild --list-generations);
nrollback takes their numbers. Without NixOS, list Home Manager generations.
EOF
      ;;
    rollback)
      cat <<'EOF'
usage: nix-workstation rollback GENERATION   (alias: nrollback)

macOS: switch to an earlier nix-darwin generation from nix-workstation info
(darwin-rebuild --switch-generation). Homebrew apps and written macOS
settings stay as they are.
On NixOS, roll back from the boot menu or a Snapper snapshot instead. Without
NixOS, run an older Home Manager generation's activate script from ninfo.
EOF
      ;;
    clean)
      cat <<'EOF'
usage: nix-workstation clean   (alias: nclean)

Remove old generations and unused store paths. Keeps the newest 10, the boot
menu's entries, and project build roots; lists what goes and asks first
(nh clean all --no-gcroots --keep 10 --ask). Without NixOS, only your own
generations (nh clean user).
EOF
      ;;
    search)
      cat <<'EOF'
usage: nix-workstation search [packages|options|prs|issues] QUERY...   (alias: nsearch)

Search nixpkgs packages, NixOS and Home Manager options, or nixpkgs pull
requests and issues (nh search). nh search --help lists its options.
EOF
      ;;
    desktop)
      cat <<'EOF'
usage: nix-workstation desktop [NAME]   (alias: ndesktop)

Without NAME, show the compositor this machine has chosen and the one
running now. With NAME, such as niri or hyprland, save it as the machine's
choice in nixos/hosts/<host>/local/desktop.nix, build and show the package
changes, then ask before adding it to the boot menu. A yes takes Snapper
snapshots around it, as switch does, then offers to reboot; the running
session stays as it is until then. A failed build or a no puts the old
choice back. Linux only.
EOF
      ;;
    mise)
      cat <<'EOF'
usage: nix-workstation mise   (alias: mup)

Upgrade the tools Mise manages (mise upgrade).
EOF
      ;;
    firmware)
      cat <<'EOF'
usage: nix-workstation firmware   (alias: fup)

Refresh the firmware list and install updates; fwupdmgr asks before
flashing (fwupdmgr refresh --force, then fwupdmgr update). Linux only; macOS
updates come from Software Update.
EOF
      ;;
    *)
      cat <<'EOF'
usage: nix-workstation COMMAND [ARGS...]

Commands (alias):
  switch (nswitch)             build, show changes, ask, then switch
  update (nupdate) [INPUT...]  update flake inputs and pinned apps, check, build
  pin (npin) [APP...]          bump pinned apps, check, build
  info (ninfo)                 list system generations
  rollback (nrollback) GEN     macOS: switch to an earlier generation
  clean (nclean)               remove old generations; keeps the newest 10
  search (nsearch) QUERY...    search packages and options
  desktop (ndesktop) [NAME]    show or pick the compositor for the next boot
  mise (mup)                   upgrade Mise tools
  firmware (fup)               install firmware updates

Run nix-workstation COMMAND --help for details.
EOF
      ;;
  esac
}

usage() {
  help "$@" >&2
  exit 2
}

die() {
  printf 'nix-workstation: %s\n' "$*" >&2
  exit 1
}

# Mark a machine whose firmware lists Windows Boot Manager, which flake.nix
# then adds to Limine's menu. Limine looks the name up among the BootOrder
# entries, so only those count. Never unmarks: a firmware reset can drop the
# entry for a while, and the menu should not change with it.
mark_windows() {
  local marker list order line found=false
  marker=$repo/nixos/hosts/$(uname -n)/local/limine-windows
  [[ -d ${marker%/*} ]] || return 0
  if ! command -v efibootmgr >/dev/null; then
    printf 'nix-workstation: efibootmgr is missing; the next nswitch looks for Windows\n' >&2
    return 0
  fi
  # No UEFI boot list, as in a VM booted through BIOS: leave the marker alone.
  list=$(efibootmgr 2>/dev/null) || return 0
  order=$(sed -n 's/^BootOrder: //p' <<<"$list")
  while IFS= read -r line; do
    # Boot0001* Windows Boot Manager<tab>device path
    if [[ ${line%%$'\t'*} =~ ^Boot([0-9A-F]{4})[*\ ]\ Windows\ Boot\ Manager$ ]] &&
      [[ ,$order, == *,${BASH_REMATCH[1]},* ]]; then
      found=true
    fi
  done <<<"$list"
  if $found && [[ ! -e $marker ]]; then
    : >"$marker"
    printf 'Windows found: Limine gets a Windows entry.\n'
  elif ! $found && [[ -e $marker ]]; then
    printf 'nix-workstation: the firmware no longer lists Windows Boot Manager; delete %s to drop Limine'\''s Windows entry\n' "$marker" >&2
  fi
}

# A failed or declined build leaves no snapshots behind. With "boot", the build
# only becomes the boot default; LABEL starts the snapshot description.
booted=false
cmd_switch() {
  local mode=${1-switch} label=${2-nswitch} answer description pre result=0
  if $wsl; then
    nh os switch --ask --hostname wsl
    return
  fi
  mark_windows
  nh os build
  if [[ $mode == boot ]]; then
    read -rp 'Boot into it next time? [y/N] ' answer
  else
    read -rp 'Switch? [y/N] ' answer
  fi
  [[ $answer == [yY]* ]] || die 'not switched'

  description="$label $(git -C "$repo" describe --always --dirty 2>/dev/null || true)"
  pre=$(sudo snapper -c root create --type pre --cleanup-algorithm number --print-number --description "$description")
  # The build above is reused; its diff was already shown. Boot default first,
  # then activate, as nixos-rebuild does: nh os switch skips the boot default
  # when any service fails during activation.
  if nh os boot --diff never; then
    booted=true
    if [[ $mode != boot ]]; then
      nh os test --diff never || result=$?
    fi
  else
    result=$?
  fi
  if ! sudo snapper -c root create --type post --pre-number "$pre" --cleanup-algorithm number --description "$description"; then
    printf 'nix-workstation: post snapshot failed; pre snapshot is #%s\n' "$pre" >&2
    ((result)) || result=1
  fi
  return "$result"
}

# The choice lives in the ignored nixos/hosts/<host>/local/desktop.nix; without it,
# nixos/desktop.nix's default applies. Only the next boot changes:
# activating now would remove the running compositor from under the session.
cmd_desktop() {
  local host state current answer
  host=$(uname -n)
  desktop_file=$repo/nixos/hosts/$host/local/desktop.nix
  [[ -d ${desktop_file%/*} ]] || die "nixos/hosts/$host/local is missing"
  state=$(nix eval --json "$NH_FLAKE#nixosConfigurations.$host" --apply '
    host: {
      current = host.config.workstation.desktop;
      names = host.options.workstation.desktop.type.functor.payload.values;
    }')
  current=$(jq -r .current <<<"$state")
  if (($# == 0)); then
    printf 'Chosen: %s\nRunning: %s\n' "$current" "${XDG_CURRENT_DESKTOP:-none}"
    return
  fi
  jq -e --arg name "$1" '.names | index($name)' <<<"$state" >/dev/null ||
    die "$1 is not a compositor; choose one of: $(jq -r '.names | join(", ")' <<<"$state")"
  if [[ $1 == "$current" ]]; then
    printf '%s is already chosen.\n' "$1"
    return
  fi

  desktop_old=
  [[ -e $desktop_file ]] && desktop_old=$(<"$desktop_file")
  trap restore_desktop EXIT
  printf '{ workstation.desktop = "%s"; }\n' "$1" >"$desktop_file"
  cmd_switch boot "ndesktop $1"
  trap - EXIT
  read -rp 'Reboot now? [y/N] ' answer
  if [[ $answer == [yY]* ]]; then
    systemctl reboot
  fi
}

# Put the old choice back unless the new one reached the boot menu.
restore_desktop() {
  $booted && return
  if [[ -n $desktop_old ]]; then
    printf '%s\n' "$desktop_old" >"$desktop_file"
  else
    rm -f -- "$desktop_file"
  fi
  printf 'nix-workstation: kept the previous compositor\n' >&2
}

# nh shows the changes and asks; it runs the activation through sudo.
cmd_switch_darwin() {
  [[ -e $repo/darwin/local/user.nix ]] ||
    die 'darwin/local/user.nix is missing; it names the account and profile'
  nh darwin switch --ask --hostname macos
}

# Home Manager first, so a failing app never blocks the terminal.
cmd_switch_home() {
  [[ -e $repo/ubuntu/local/user.nix ]] ||
    die 'ubuntu/local/user.nix is missing; it names the account'
  # A file Ubuntu made where a link goes is kept with this ending, as on the Mac.
  nh home switch --ask --configuration ubuntu --backup-extension before-home-manager
  "$repo/ubuntu/apps.sh"
}

# update and pin change only flake.lock and nixos/pins/_sources, then check and
# build without switching. The copies taken first give the summary.
saved=
nvim_lock=$repo/configs/nvim/nvim-pack-lock.json
prepare() {
  saved=$(mktemp -d)
  cp -- "$repo/flake.lock" "$repo/nixos/pins/_sources/generated.json" "$nvim_lock" "$saved/"
  trap finish EXIT
}

finish() {
  local result=$?
  if updated; then
    printf '\nUpdated:\n'
    jq -r --slurpfile old "$saved/flake.lock" '
      .nodes as $new | $old[0].nodes as $was | .nodes.root.inputs | to_entries[]
      | select(.value | type == "string") | .value as $node
      | select($was[$node].locked.narHash != $new[$node].locked.narHash)
      | "  \(.key): \($was[$node].locked.lastModified // 0 | todate[:10]) → \($new[$node].locked.lastModified | todate[:10])"
    ' "$repo/flake.lock"
    jq -r --slurpfile old "$saved/generated.json" '
      def short: if length == 40 then .[:7] else . end;
      to_entries[] | select($old[0][.key].version != .value.version)
      | "  \(.key): \($old[0][.key].version // "new" | short) → \(.value.version | short)"
    ' "$repo/nixos/pins/_sources/generated.json"
    jq -r --slurpfile old "$saved/nvim-pack-lock.json" '
      .plugins | to_entries[] | select($old[0].plugins[.key].rev != .value.rev)
      | "  \(.key): \($old[0].plugins[.key].rev // "new" | .[:7]) → \(.value.rev[:7])"
    ' "$nvim_lock"
  fi
  if pending; then
    if ((result)); then
      printf 'Failed. Undo: ' >&2
    else
      printf 'Built, not applied. Run nswitch to apply. Undo: ' >&2
    fi
    # The plugins nvim_plugins installed stay until nswitch follows the lock.
    printf "git -C %q restore flake.lock nixos/pins/_sources configs/nvim/nvim-pack-lock.json; the next nswitch puts Neovim's plugins back\n" "$repo" >&2
  fi
  rm -rf -- "$saved"
  return "$result"
}

updated() {
  ! cmp -s "$saved/flake.lock" "$repo/flake.lock" ||
    ! cmp -s "$saved/generated.json" "$repo/nixos/pins/_sources/generated.json" ||
    ! cmp -s "$saved/nvim-pack-lock.json" "$nvim_lock"
}

# Changed since the last commit, by this run or an earlier one.
pending() {
  [[ -n $(git -C "$repo" status --porcelain -- flake.lock nixos/pins/_sources configs/nvim/nvim-pack-lock.json) ]]
}

# Check and build the system without switching; nswitch reuses the build.
build() {
  if ! pending; then
    printf 'Already up to date.\n'
    return
  fi
  if $darwin; then
    [[ -e $repo/darwin/local/user.nix ]] ||
      die 'darwin/local/user.nix is missing; it names the account and profile'
    # just check needs Hyprland, Niri and the Linux dev shell; macOS only
    # evaluates.
    nix flake check --no-build "$NH_FLAKE"
    nh darwin build --hostname macos
  else
    (cd -- "$repo" && nix develop path:. -c just check)
    if $wsl; then
      nh os build --hostname wsl
    else
      nh os build
    fi
  fi
}

# Every name must be one of KIND's names, which come on stdin.
check_names() {
  local kind=$1 name names
  shift
  names=$(cat)
  for name; do
    grep -qxF -- "$name" <<<"$names" ||
      die "$name is not a $kind; choose from: $(paste -sd ' ' <<<"$names")"
  done
}

# Run a command, showing its output only when it fails.
quietly() {
  local log result=0
  log=$(mktemp)
  "$@" >"$log" 2>&1 || result=$?
  ((result == 0)) || cat -- "$log" >&2
  rm -f -- "$log"
  return "$result"
}

# nvfetcher runs in the checkout, since claude-desktop.sh's path is relative.
# The summary at the end lists what changed.
bump_pins() {
  local filter=()
  if (($#)); then
    filter=(--filter "^($(IFS='|'; printf '%s' "$*"))\$")
  fi
  printf 'Checking pinned apps...\n'
  (
    cd -- "$repo"
    quietly nix develop path:. -c nvfetcher --config nixos/pins/nvfetcher.toml --build-dir nixos/pins/_sources "${filter[@]}"
    quietly nix develop path:. -c nixos/pins/claude-desktop.sh \
      "$(jq -r '."claude-desktop".version' nixos/pins/_sources/generated.json)" \
      "$(jq -r '."claude-desktop".src.sha256' nixos/pins/_sources/generated.json)"
  )
}

cmd_update() {
  $home && die 'flake.lock comes from NixOS: run git pull, then nswitch'
  check_names 'flake input' "$@" < <(jq -r '.nodes.root.inputs | keys[]' "$repo/flake.lock")
  prepare
  nix flake update "$@" --flake "$NH_FLAKE"
  if (($# == 0)) && ! $darwin && ! $wsl; then
    bump_pins
  fi
  (($# != 0)) || nvim_plugins version
  build
}

# Neovim's own plugin manager, without its confirmation buffer: version takes
# each plugin's newest and writes the lock file; lockfile moves this machine to
# the lock file's versions, as Neovim's help syncs machines.
nvim_plugins() {
  command -v nvim >/dev/null || return 0
  nvim --headless "+lua vim.pack.update(nil, { force = true, target = '$1' })" +qa
}

cmd_pin() {
  $darwin && die 'pinned apps are NixOS only'
  $home && die 'pinned apps are NixOS only'
  $wsl && die 'WSL does not install the pinned apps'
  check_names 'pinned app' "$@" < <(sed -n 's/^\[\(.*\)\]$/\1/p' "$repo/nixos/pins/nvfetcher.toml")
  prepare
  bump_pins "$@"
  build
}

command=${1-}
(($#)) && shift
for arg in "$command" "$@"; do
  if [[ $arg == -h || $arg == --help ]]; then
    help "$command"
    exit
  fi
done

[[ $NH_FLAKE == path:* ]] || die 'NH_FLAKE must be a path: flake'
case $command in
  clean)
    if $home; then
      nh clean user --no-gcroots --keep 10 --ask "$@"
    else
      nh clean all --no-gcroots --keep 10 --ask "$@"
    fi
    ;;
  search) nh search "$@" ;;
  update) cmd_update "$@" ;;
  pin) cmd_pin "$@" ;;
  mise) (($# == 0)) || usage mise; mise upgrade ;;
  *)
    if $darwin; then
      case $command in
        switch)
          (($# == 0)) || usage switch
          cmd_switch_darwin
          nvim_plugins lockfile
          ;;
        info) (($# == 0)) || usage info; darwin-rebuild --list-generations ;;
        rollback)
          (($# == 1)) && [[ $1 =~ ^[0-9]+$ ]] || usage rollback
          sudo darwin-rebuild --switch-generation "$1"
          ;;
        firmware) die 'macOS updates come from Software Update' ;;
        desktop) die 'the compositor choice is Linux only' ;;
        *) usage ;;
      esac
    else
      case $command in
        switch)
          (($# == 0)) || usage switch
          if $home; then cmd_switch_home; else cmd_switch; fi
          nvim_plugins lockfile
          ;;
        info)
          if $home; then
            nix profile history --profile "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager"
          else
            nh os info "$@"
          fi
          ;;
        desktop)
          $home && die 'pick the session at the login screen'
          $wsl && die 'WSL has no compositor'
          (($# <= 1)) || usage desktop
          cmd_desktop "$@"
          ;;
        rollback)
          $home && die "run an older Home Manager generation's activate script from ninfo"
          $wsl && die 'in WSL, roll back with sudo nixos-rebuild switch --rollback'
          die 'on NixOS, roll back from the boot menu or a Snapper snapshot'
          ;;
        firmware)
          $wsl && die 'in WSL, Windows installs the firmware'
          (($# == 0)) || usage firmware
          # --force: a plain refresh fails when the metadata is recent.
          fwupdmgr refresh --force && fwupdmgr update
          ;;
        *) usage ;;
      esac
    fi
    ;;
esac
